---
import { site } from '../../data/site';
import { photo as getPhoto, srcset } from '../../data/extra';
interface Props { eyebrow: string; title: string; lede?: string; photo?: string; service?: string; crumbs?: { href: string; label: string }[] }
const { eyebrow, title, lede, photo, service, crumbs = [] } = Astro.props;
const p = photo ? getPhoto(photo) : null;
const phone = site.phones[0];
---
<section class:list={['ph-hero on-navy', { 'has-photo': !!p }]}>
  <div class="container ph-hero__in">
    <div class="ph-hero__copy">
      {crumbs.length > 0 ? (
        <nav class="ph-hero__crumbs label" aria-label="Breadcrumb" data-reveal>
          {crumbs.map((c) => <><a class="link-u" href={c.href}>{c.label}</a><span aria-hidden="true">/</span></>)}
          <span aria-current="page">{eyebrow}</span>
        </nav>
      ) : (
        <p class="label ph-hero__eyebrow" data-reveal>{eyebrow}</p>
      )}
      <h1 class="display h-1 ph-hero__h" data-reveal style="--d:0.04s">{title}</h1>
      {lede && <p class="lede ph-hero__lede" data-reveal style="--d:0.1s">{lede}</p>}
      <div class="ph-hero__cta" data-reveal style="--d:0.16s">
        <a class="btn" href={service ? `/contact?service=${service}` : '/contact'} data-magnetic>Get a free quote <span class="arr">→</span></a>
        <a class="ph-hero__tel" href={`tel:${phone.tel}`}>{phone.display}</a>
      </div>
    </div>
    {p && (
      <figure class="ph-hero__ph ph" data-reveal style="--d:0.08s">
        <img src={`/img/work/${p.id}-1600.webp`} srcset={srcset(p.id)} sizes="(max-width: 860px) 100vw, 45vw" alt={p.alt} width={p.w} height={p.h} fetchpriority="high" />
      </figure>
    )}
  </div>
</section>

<style>
  .ph-hero { padding-top: calc(var(--header-h) + clamp(2.5rem, 2rem + 3vw, 5rem)); padding-bottom: clamp(3rem, 2rem + 4vw, 6rem); }
  .ph-hero__in { display: grid; grid-template-columns: minmax(0, 1fr); gap: var(--space-7); align-items: end; }
  .has-photo .ph-hero__in { grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr); }
  .ph-hero__crumbs { display: flex; gap: 0.5rem; color: var(--sand); }
  .ph-hero__crumbs a { color: var(--on-dark-soft); }
  .ph-hero__crumbs a:hover { color: #fff; }
  .ph-hero__eyebrow { color: var(--sand); }
  .ph-hero__h { margin-top: var(--space-3); font-size: var(--fs-display-2); max-width: 16ch; text-wrap: balance; }
  .ph-hero__lede { margin-top: var(--space-5); color: var(--on-dark-soft); max-width: 46ch; }
  .ph-hero__cta { display: flex; align-items: center; gap: var(--space-5); margin-top: var(--space-6); flex-wrap: wrap; }
  .ph-hero__tel { font-family: var(--font-display); font-weight: 700; font-size: 1.35rem; letter-spacing: -0.01em; }
  .ph-hero__ph { aspect-ratio: 4 / 3; border-radius: var(--radius); }
  @media (max-width: 860px) {
    .has-photo .ph-hero__in { grid-template-columns: minmax(0, 1fr); }
    .ph-hero__ph { order: -1; aspect-ratio: 16 / 11; }
  }
</style>
