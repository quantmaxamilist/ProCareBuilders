---
import { site } from '../../data/site';
import { buildingTrades, nav } from '../../data/extra';
import { landServices } from '../../data/landscaping';
const year = new Date().getFullYear();
---
<footer class="ftr on-deep">
  <div class="container ftr__top">
    <div class="ftr__brand">
      <img src="/img/logo-white.png" alt="Pro Care Builders" width="1014" height="757" loading="lazy" />
    </div>
    <div class="ftr__col">
      <p class="label ftr__h">Landscaping</p>
      <ul>{landServices.map((s) => <li><a class="link-u" href={`/landscaping/${s.slug}`}>{s.name}</a></li>)}</ul>
    </div>
    <div class="ftr__col">
      <p class="label ftr__h">Building</p>
      <ul>{buildingTrades.map((t) => <li><a class="link-u" href={`/building#${t.slug}`}>{t.name.replace('/', '/​')}</a></li>)}</ul>
    </div>
    <div class="ftr__col">
      <p class="label ftr__h">Contact</p>
      <ul class="ftr__contact">
        {site.phones.map((p) => <li><a class="ftr__big" href={`tel:${p.tel}`}>{p.display}</a></li>)}
        <li><a class="link-u" href={`mailto:${site.email}`}>{site.email}</a></li>
        <li class="muted">{site.location}</li>
      </ul>
      <div class="ftr__social">
        <a href={site.social.facebook} target="_blank" rel="noopener" aria-label="Pro Care Builders on Facebook">
          <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path fill="currentColor" d="M13.5 21v-7.5h2.6l.4-3h-3V8.6c0-.9.3-1.5 1.5-1.5h1.6V4.4c-.3 0-1.2-.1-2.3-.1-2.3 0-3.9 1.4-3.9 4v2.2H7.8v3h2.6V21h3.1Z"/></svg>
        </a>
        <a href={site.social.instagram} target="_blank" rel="noopener" aria-label="Pro Care Builders on Instagram">
          <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path fill="currentColor" d="M12 7.3a4.7 4.7 0 1 0 0 9.4 4.7 4.7 0 0 0 0-9.4Zm0 7.7a3 3 0 1 1 0-6 3 3 0 0 1 0 6Zm6-7.9a1.1 1.1 0 1 1-2.2 0 1.1 1.1 0 0 1 2.2 0ZM21 8c0-1.6-.4-3-1.6-4.2C18.2 2.6 16.8 2.2 15.2 2.2H8.8C7.2 2.2 5.8 2.6 4.6 3.8 3.4 5 3 6.4 3 8v8c0 1.6.4 3 1.6 4.2 1.2 1.2 2.6 1.6 4.2 1.6h6.4c1.6 0 3-.4 4.2-1.6 1.2-1.2 1.6-2.6 1.6-4.2V8Zm-2 9.4a3 3 0 0 1-1.7 1.7c-1.2.5-4 .4-5.3.4s-4.1.1-5.3-.4a3 3 0 0 1-1.7-1.7c-.5-1.2-.4-4-.4-5.4s-.1-4.1.4-5.3A3 3 0 0 1 6.7 5c1.2-.5 4-.4 5.3-.4s4.1-.1 5.3.4A3 3 0 0 1 19 6.6c.5 1.2.4 4 .4 5.4s.1 4.1-.4 5.4Z"/></svg>
        </a>
      </div>
    </div>
  </div>
  <div class="container ftr__bottom">
    <nav class="ftr__nav" aria-label="Footer">
      <a href="/">Home</a>
      {nav.map((n) => <a href={n.href}>{n.label}</a>)}
    </nav>
    <p class="ftr__legal">
      © {year} {site.legalName}. Registered in England and Wales, company no. {site.companyNumber}.
      Registered office: {site.registeredOffice}.
    </p>
  </div>
</footer>

<style>
  .ftr { padding-block: var(--space-9) var(--space-6); }
  .ftr__top { display: grid; grid-template-columns: minmax(0, 1.2fr) repeat(3, minmax(0, 1fr)); gap: var(--space-7); }
  .ftr__brand img { width: min(230px, 100%); }
  .ftr__h { color: var(--sand); margin-bottom: var(--space-4); }
  .ftr__col ul { display: grid; gap: 0.4rem; color: var(--on-dark-soft); }
  .ftr__col a:hover { color: #fff; }
  .ftr__big { font-family: var(--font-display); font-weight: 700; font-size: 1.35rem; color: #fff; letter-spacing: -0.01em; }
  .ftr__contact { gap: 0.5rem !important; }
  .ftr__social { display: flex; gap: var(--space-2); margin-top: var(--space-5); }
  .ftr__social a { width: 44px; height: 44px; display: grid; place-items: center; border: 1px solid var(--navy-line); border-radius: 50%; transition: background var(--dur-1), color var(--dur-1); }
  .ftr__social a:hover { background: var(--sand); color: var(--ink); }
  .ftr__bottom { margin-top: var(--space-8); padding-top: var(--space-5); border-top: 1px solid var(--navy-line); display: flex; justify-content: space-between; gap: var(--space-5); flex-wrap: wrap; font-size: var(--fs-small); color: var(--on-dark-soft); }
  .ftr__nav { display: flex; gap: var(--space-5); flex-wrap: wrap; }
  .ftr__nav a { min-height: 32px; display: inline-flex; align-items: center; }
  .ftr__nav a:hover { color: #fff; }
  .ftr__legal { max-width: 62ch; }
  @media (max-width: 980px) {
    .ftr__top { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .ftr__brand { grid-column: 1 / -1; }
  }
  @media (max-width: 520px) {
    .ftr__top { grid-template-columns: minmax(0, 1fr); gap: var(--space-6); }
    .ftr { padding-bottom: calc(var(--space-6) + 72px); }
  }
</style>
