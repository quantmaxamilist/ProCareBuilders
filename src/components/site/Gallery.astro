---
// Photo grid + lightbox. Items carry ids so /projects#<photo-id> deep-links work.
import { photo as getPhoto, srcset, type Photo } from '../../data/extra';
interface Props { ids: string[]; filter?: boolean; cols?: 2 | 3 }
const { ids, filter = false, cols = 3 } = Astro.props;
const items: Photo[] = ids.map(getPhoto);
const counts = { all: items.length, landscaping: items.filter((p) => p.arm === 'landscaping').length, building: items.filter((p) => p.arm === 'building').length };
---
<div class="gal" data-gallery>
  {filter && (
    <div class="gal__filter" role="group" aria-label="Filter projects">
      <button type="button" class="is-on" data-filter="all">All <span>{counts.all}</span></button>
      <button type="button" data-filter="landscaping">Landscaping <span>{counts.landscaping}</span></button>
      <button type="button" data-filter="building">Building <span>{counts.building}</span></button>
    </div>
  )}
  <ul class:list={['gal__grid', `cols-${cols}`]}>
    {items.map((p, i) => (
      <li class="gal__item" id={filter ? p.id : undefined} data-arm={p.arm} data-reveal style={`--d:${(i % cols) * 0.05}s`}>
        <button type="button" class="gal__btn ph" data-open={i} aria-label={`Open photo: ${p.alt}`}>
          <img src={`/img/work/${p.id}-800.webp`} srcset={srcset(p.id)} sizes={cols === 3 ? '(max-width: 640px) 100vw, (max-width: 1000px) 50vw, 33vw' : '(max-width: 640px) 100vw, 50vw'} alt={p.alt} width={p.w} height={p.h} loading="lazy" decoding="async" />
        </button>
      </li>
    ))}
  </ul>
  <div class="lb" data-lb hidden role="dialog" aria-modal="true" aria-label="Photo viewer">
    <button type="button" class="lb__x" data-lb-close aria-label="Close">×</button>
    <button type="button" class="lb__nav lb__prev" data-lb-prev aria-label="Previous photo">←</button>
    <figure class="lb__fig">
      <img data-lb-img alt="" />
      <figcaption class="lb__cap"><span class="label" data-lb-count></span><span data-lb-alt></span></figcaption>
    </figure>
    <button type="button" class="lb__nav lb__next" data-lb-next aria-label="Next photo">→</button>
  </div>
  <script type="application/json" data-gal-data set:html={JSON.stringify(items.map((p) => ({ src: `/img/work/${p.id}-1600.webp`, alt: p.alt, arm: p.arm })))} />
</div>

<style>
  .gal__filter { display: flex; gap: var(--space-2); flex-wrap: wrap; margin-bottom: var(--space-6); }
  .gal__filter button { min-height: 44px; padding: 0 1rem; border: 1px solid var(--line); border-radius: var(--radius); font-weight: 600; font-size: 0.95rem; transition: background var(--dur-1), color var(--dur-1); }
  .gal__filter button span { font-family: var(--font-mono); font-size: 0.75rem; opacity: 0.6; margin-left: 0.25rem; }
  .gal__filter button.is-on { background: var(--navy); color: #fff; border-color: var(--navy); }
  .gal__grid { columns: 3; column-gap: var(--space-4); }
  .gal__grid.cols-2 { columns: 2; }
  .gal__item { break-inside: avoid; margin-bottom: var(--space-4); }
  .gal__item[hidden] { display: none; }
  .gal__btn { display: block; width: 100%; border-radius: var(--radius); cursor: zoom-in; }
  .gal__btn img { transition: transform 0.9s var(--ease-out); }
  .gal__btn:hover img { transform: scale(1.04); }
  @media (max-width: 1000px) { .gal__grid { columns: 2; } }
  @media (max-width: 560px) { .gal__grid, .gal__grid.cols-2 { columns: 1; } }

  .lb { position: fixed; inset: 0; z-index: var(--z-lightbox); background: rgba(7, 15, 39, 0.96); color: #fff; display: grid; grid-template-columns: 64px minmax(0, 1fr) 64px; align-items: center; padding: var(--space-6) var(--space-4); }
  .lb[hidden] { display: none; }
  .lb__fig { display: grid; gap: var(--space-3); justify-items: center; max-height: 100%; }
  .lb__fig img { max-height: calc(100svh - 9rem); width: auto; max-width: 100%; object-fit: contain; border-radius: var(--radius); }
  .lb__cap { display: flex; gap: var(--space-4); align-items: baseline; color: var(--on-dark-soft); font-size: var(--fs-small); text-align: center; flex-wrap: wrap; justify-content: center; }
  .lb__cap .label { color: var(--sand); }
  .lb__nav, .lb__x { width: 48px; height: 48px; display: grid; place-items: center; border: 1px solid var(--navy-line); border-radius: 50%; font-size: 1.3rem; transition: background var(--dur-1), color var(--dur-1); }
  .lb__nav:hover, .lb__x:hover { background: var(--sand); color: var(--ink); }
  .lb__x { position: absolute; top: var(--space-4); right: var(--space-4); font-size: 1.6rem; }
  .lb__next { justify-self: end; }
  @media (max-width: 640px) {
    .lb { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); grid-template-rows: 1fr auto; padding: var(--space-8) var(--space-3) var(--space-5); }
    .lb__fig { grid-column: 1 / -1; grid-row: 1; }
    .lb__prev { grid-row: 2; }
    .lb__next { grid-row: 2; }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-gallery]').forEach((g) => {
    const data = JSON.parse(g.querySelector('[data-gal-data]')!.textContent || '[]');
    const lb = g.querySelector('[data-lb]') as HTMLElement;
    const img = g.querySelector('[data-lb-img]') as HTMLImageElement;
    const count = g.querySelector('[data-lb-count]') as HTMLElement;
    const alt = g.querySelector('[data-lb-alt]') as HTMLElement;
    const items = [...g.querySelectorAll<HTMLElement>('.gal__item')];
    let idx = 0, opener: HTMLElement | null = null;
    const visible = () => items.map((el, i) => (el.hidden ? -1 : i)).filter((i) => i >= 0);
    const show = (i: number) => {
      idx = i;
      const vis = visible();
      img.src = data[i].src; img.alt = data[i].alt;
      count.textContent = `Photo ${vis.indexOf(i) + 1} of ${vis.length}`;
      alt.textContent = data[i].alt;
    };
    const lenis = () => (window as any).__pcb?.lenis;
    const open = (i: number, from: HTMLElement) => { opener = from; show(i); lb.hidden = false; lenis()?.stop(); document.body.style.overflow = 'hidden'; (lb.querySelector('[data-lb-close]') as HTMLElement).focus(); };
    const close = () => { lb.hidden = true; lenis()?.start(); document.body.style.overflow = ''; opener?.focus(); };
    const step = (d: number) => { const vis = visible(); const k = vis.indexOf(idx); show(vis[(k + d + vis.length) % vis.length]); };
    g.addEventListener('click', (e) => {
      const t = e.target as HTMLElement;
      const o = t.closest<HTMLElement>('[data-open]');
      if (o) return open(+o.dataset.open!, o);
      if (t.closest('[data-lb-close]') || t === lb) return close();
      if (t.closest('[data-lb-prev]')) return step(-1);
      if (t.closest('[data-lb-next]')) return step(1);
      const f = t.closest<HTMLButtonElement>('[data-filter]');
      if (f) {
        g.querySelectorAll('[data-filter]').forEach((b) => b.classList.toggle('is-on', b === f));
        items.forEach((el) => { el.hidden = f.dataset.filter !== 'all' && el.dataset.arm !== f.dataset.filter; if (!el.hidden) el.classList.add('is-in'); });
        (window as any).__pcb?.ScrollTrigger?.refresh();
      }
    });
    document.addEventListener('keydown', (e) => {
      if (lb.hidden) return;
      if (e.key === 'Escape') close();
      else if (e.key === 'ArrowLeft') step(-1);
      else if (e.key === 'ArrowRight') step(1);
    });
    let x0 = 0;
    lb.addEventListener('touchstart', (e) => { x0 = e.touches[0].clientX; }, { passive: true });
    lb.addEventListener('touchend', (e) => { const dx = e.changedTouches[0].clientX - x0; if (Math.abs(dx) > 50) step(dx < 0 ? 1 : -1); }, { passive: true });
    // Deep link: /projects#photo-id opens on that photo's position.
    if (location.hash) { const el = g.querySelector(location.hash.replace(/[^#\w-]/g, '')); if (el) el.classList.add('is-in'); }
  });
</script>
