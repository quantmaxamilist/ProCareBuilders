---
// "Our Services": the old site's intro and 14-item list, split into the two arms.
import { home, oldServiceList } from '../../data/site';
import { buildingTrades } from '../../data/extra';
import { landServices } from '../../data/landscaping';
const landNames = new Set(landServices.map((s) => s.name));
const hrefFor = (name: string) => {
  const ls = landServices.find((s) => s.name === name);
  if (ls) return `/landscaping/${ls.slug}`;
  const bt = buildingTrades.find((t) => t.name === name);
  if (bt) return `/building#${bt.slug}`;
  return '/contact';
};
const land = oldServiceList.filter((s) => landNames.has(s));
const extraLand = landServices.filter((s) => !oldServiceList.includes(s.name)).map((s) => s.name);
const build = oldServiceList.filter((s) => !landNames.has(s) && s !== 'and more');
---
<section class="trades section">
  <div class="container trades__in">
    <div class="trades__head" data-reveal>
      <p class="label muted">{oldServiceList.length - 1} trades, one team</p>
      <h2 class="display h-2">{home.servicesTitle}</h2>
      <p class="lede muted trades__intro">{home.servicesIntro}</p>
    </div>
    <div class="trades__cols">
      <div class="trades__col" data-reveal>
        <p class="label trades__arm">Building &amp; renovation</p>
        <ol>
          {build.map((t) => <li><a href={hrefFor(t)}><span>{t.replace('/', '/​')}</span><i>→</i></a></li>)}
        </ol>
      </div>
      <div class="trades__col" data-reveal style="--d:0.08s">
        <p class="label trades__arm">Landscaping</p>
        <ol>
          {[...land, ...extraLand].map((t) => <li><a href={hrefFor(t)}><span>{t}</span><i>→</i></a></li>)}
        </ol>
        <p class="trades__more muted">and more</p>
      </div>
    </div>
  </div>
</section>

<style>
  .trades { background: var(--paper); }
  .trades__in { display: grid; grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.4fr); gap: var(--space-8); align-items: start; }
  .trades__head { position: sticky; top: calc(var(--header-h) + var(--space-5)); }
  .trades__head h2 { margin-top: var(--space-3); }
  .trades__intro { margin-top: var(--space-5); max-width: 38ch; }
  .trades__cols { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-6); }
  .trades__arm { color: var(--sand-deep); padding-bottom: var(--space-3); border-bottom: 2px solid var(--ink); }
  .trades__col li a { display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding: 0.9rem 0; border-bottom: 1px solid var(--line); font-family: var(--font-display); font-weight: 700; font-size: clamp(1.15rem, 0.95rem + 0.7vw, 1.6rem); letter-spacing: -0.015em; line-height: 1.15; }
  .trades__col li a span { min-width: 0; }
  .trades__col li a i { font-style: normal; color: var(--sand-deep); opacity: 0; transform: translateX(-8px); transition: opacity var(--dur-2), transform var(--dur-2) var(--ease-out); }
  .trades__col li a:hover i { opacity: 1; transform: none; }
  .trades__col li a:hover span { color: var(--navy-2); }
  .trades__more { padding-top: 0.9rem; font-size: var(--fs-small); }
  @media (max-width: 960px) {
    .trades__in { grid-template-columns: minmax(0, 1fr); gap: var(--space-6); }
    .trades__head { position: static; }
  }
  @media (max-width: 560px) { .trades__cols { grid-template-columns: minmax(0, 1fr); } .trades__col li a i { opacity: 1; transform: none; } }
</style>
